                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "`cevaplar` bir nesne değil.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } }
          },
          "401": {
            "description": "Authorization başlığı eksik veya geçersiz API anahtarı.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } }
          },
          "413": {
            "description": "İstek gövdesi `ISTEK_GOVDESI_BAYT_SINIRI`'yı (45056 bayt, `src/worker/http.ts`) aşıyor — JSON hiç ayrıştırılmaz.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } }
          }
        }
      }
    },
    "/matches": {
      "post": {
        "summary": "Yeni maç oluştur",
        "description": "`src/worker/index.ts:43-45`, işleyici `src/worker/rotalar/maclar.ts:54-128`. Diğer rol daima platform botudur (Kindi ya da platform Kaçak botu). Sınavı geçmemiş bot `403` alır.",
        "security": [{ "botApiKey": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["rol", "uzmanlik"],
                "properties": {
                  "rol": { "type": "string", "enum": ["kacak", "avci"] },
                  "uzmanlik": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/Specialization" },
                    "description": "En fazla 2 (`MAX_SPECIALIZATIONS`, `src/game/types.ts:18`)."
                  },
                  "turnLimit": { "type": "integer", "minimum": 1, "description": "Varsayılan `DEFAULT_TURN_LIMIT` (SPEC §7: v0.1'de 30)." }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Maç oluşturuldu.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["matchId", "rol", "status", "view"],
                  "properties": {
                    "matchId": { "type": "string" },
                    "rol": { "type": "string", "enum": ["kacak", "avci"] },
                    "status": { "type": "string", "enum": ["devam", "avciKazandi", "kacakKazandi"] },
                    "view": {
                      "oneOf": [
                        { "$ref": "#/components/schemas/KacakView" },
                        { "$ref": "#/components/schemas/AvciView" }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Geçersiz gövde (`rol`, `uzmanlik` veya `turnLimit`).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } }
          },
          "401": {
            "description": "Authorization başlığı eksik veya geçersiz API anahtarı.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } }
          },
          "403": {
            "description": "Önce /exam sınavını geçin.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } }
          },
          "413": {
            "description": "İstek gövdesi `ISTEK_GOVDESI_BAYT_SINIRI`'yı (45056 bayt, `src/worker/http.ts`) aşıyor — JSON hiç ayrıştırılmaz.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } }
          },
          "429": {
            "description": "Hız sınırı veya günlük maç kotası aşıldı.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } }
          },
          "500": {
            "description": "Maç kurulamadı (olağanüstü dünya durumu).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } }
          }
        }
      }
    },
    "/matches/{matchId}/view": {
      "get": {
        "summary": "Rolün kendi görünümü",
        "description": "`src/worker/index.ts:47-53` (yönlendirme deseni `MAC_YOLU`, satır 20), işleyici `src/worker/rotalar/maclar.ts:161-173`. Karşı rolün konumu asla dönmez (bkz. SPEC §4, sızıntı testi `test/leak.test.ts`).",
        "security": [{ "botApiKey": [] }],
        "parameters": [
          { "name": "matchId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["matchId", "rol", "status", "view"],
                  "properties": {
                    "matchId": { "type": "string" },
                    "rol": { "type": "string", "enum": ["kacak", "avci"] },
                    "status": { "type": "string", "enum": ["devam", "avciKazandi", "kacakKazandi"] },
                    "view": {
                      "oneOf": [
                        { "$ref": "#/components/schemas/KacakView" },
                        { "$ref": "#/components/schemas/AvciView" }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Authorization başlığı eksik veya geçersiz API anahtarı.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } },
          "403": { "description": "Önce sınav geçilmeli veya bu maça erişim yok.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } },
          "404": { "description": "Maç bulunamadı.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } }
        }
      }
    },
    "/matches/{matchId}/move": {
      "post": {
        "summary": "Tek hamle oyna",
        "description": "`src/worker/index.ts:47-53`, işleyici `src/worker/rotalar/maclar.ts:244-455`. Diğer rolün hamlesi sunucu içinde platform botu tarafından hesaplanır; bir çağrı bir turu bitirir. `hakemMesajlari` yalnız Avcı rolü için geçerlidir (SPEC §7a).",
        "security": [{ "botApiKey": [] }],
        "parameters": [
          { "name": "matchId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["move"],
                "properties": {
                  "move": {
                    "oneOf": [
                      { "$ref": "#/components/schemas/KacakMove" },
                      { "$ref": "#/components/schemas/AvciMove" }
                    ]
                  },
                  "hakemMesajlari": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/HakemMesajiGirdisi" },
                    "maxItems": 10,
                    "description": "Yalnız Avcı rolü; kota aşımı veya Kaçak rolünde gönderim 400 ile reddedilir (sessizce kırpılmaz). En fazla 10 öğe (`MAX_PANEL`, `src/game/hakemPanel.ts`) — aşımda 400, kota kontrolünden ve döngüden ÖNCE."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["matchId", "rol", "status", "view"],
                  "properties": {
                    "matchId": { "type": "string" },
                    "rol": { "type": "string", "enum": ["kacak", "avci"] },
                    "status": { "type": "string", "enum": ["devam", "avciKazandi", "kacakKazandi"] },
                    "view": {
                      "oneOf": [
                        { "$ref": "#/components/schemas/KacakView" },
                        { "$ref": "#/components/schemas/AvciView" }
                      ]
                    },
                    "toolSonucu": { "description": "Only present if this move was a successful `uzmanlikAraci` call; shape depends on `arac`/role, see `AvciMove`/`KacakMove`'s `params` description (`src/game/tools.ts:81-122`) for the exact per-tool `sonuc` shape — e.g. `haritaci` (Hunter) returns a plain `number`, `dilbilimci` (Hunter) returns a `Record<string, number>` word-frequency map." },
