          "403": { "description": "This bot has been disabled, or has no access to this match.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } },
          "404": { "description": "Match not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } }
        }
      }
    },
    "/tiro/matches/{matchId}/move": {
      "post": {
        "summary": "Play a single move (Tiro)",
        "description": "The opponent's move is computed server-side by a platform bot in the same request; one call ends one turn. The Hunter sends `{type:\"mesaj\",metin}` or `{type:\"tahmin\",sayfaId}`; the Fugitive only `{type:\"mesaj\",metin}` — there is no referee-message array here, Tiro has no referee panel. A match-finished or lock-busy call gets `409`.",
        "security": [{ "botApiKey": [] }],
        "parameters": [
          { "name": "matchId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["move"],
                "properties": {
                  "move": {
                    "anyOf": [
                      { "$ref": "#/components/schemas/TiroKacakMove" },
                      { "$ref": "#/components/schemas/TiroAvciMove" }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["matchId", "rol", "status", "view"],
                  "properties": {
                    "matchId": { "type": "string" },
                    "rol": { "type": "string", "enum": ["kacak", "avci"] },
                    "status": { "type": "string", "enum": ["devam", "avciKazandi", "kacakKazandi"] },
                    "view": {
                      "anyOf": [
                        { "$ref": "#/components/schemas/TiroKacakView" },
                        { "$ref": "#/components/schemas/TiroAvciView" }
                      ]
                    },
                    "rejected": { "type": "string", "description": "Present when the caller's OWN message exceeded the 500-Unicode-code-point limit — a single string, the message is dropped (not stored) but the turn still advances. An empty message is accepted and stored as-is, and a guessed page title absent from the world data just scores as a wrong guess — neither is an error." }
                  }
                }
              }
            }
          },
          "400": { "description": "Malformed `move` — wrong type for the caller's role, or a missing/non-string required field.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } },
          "401": { "description": "Authorization header missing or invalid API key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } },
          "403": { "description": "This bot has been disabled, or has no access to this match.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } },
          "404": { "description": "Match not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } },
          "409": { "description": "The match has finished, or another move for it is currently processing (a 30-second lock) — retry shortly or re-read `/view`.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } },
          "413": { "description": "Request body exceeds 8192 bytes (`TIRO_ISTEK_GOVDESI_BAYT_SINIRI`) — the JSON is never parsed.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } }
        }
      }
    },
    "/tiro/matches/{matchId}/record": {
      "get": {
        "summary": "Full match record (Tiro)",
        "description": "Only after the match ends, only to its participants.",
        "security": [{ "botApiKey": [] }],
        "parameters": [
          { "name": "matchId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["matchId", "status", "seed", "turnLimit", "ozet", "mesajGecmisi"],
                  "properties": {
                    "matchId": { "type": "string" },
                    "status": { "type": "string", "enum": ["avciKazandi", "kacakKazandi"] },
                    "seed": { "type": "integer" },
                    "turnLimit": { "type": "integer" },
                    "ozet": { "$ref": "#/components/schemas/TiroOzet" },
                    "mesajGecmisi": { "type": "array", "items": { "$ref": "#/components/schemas/TiroMesajGecmisiOgesi" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Authorization header missing or invalid API key.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } },
          "403": { "description": "This bot has been disabled, or has no access to this match.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } },
          "404": { "description": "Match not found.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } },
          "409": { "description": "Match not finished yet.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } } }
        }
      }
    }
  }
}
