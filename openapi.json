{
  "openapi": "3.0.3",
  "info": {
    "title": "AK-1835-1903",
    "description": "Kerckhoffs ilkesini sınayan bir Avcı-Kaçak (hide-and-seek) protokolü. Rotalar `src/worker/index.ts:22-58` içindeki yönlendiriciden, şema alanları ilgili rota işleyicilerinden çıkarılmıştır (her rota tanımında dosya:satır referansı verilmiştir). Uydurma uç nokta yoktur.",
    "version": "0.1.0"
  },
  "servers": [
    { "url": "http://127.0.0.1:8787", "description": "yerel wrangler dev" }
  ],
  "components": {
    "securitySchemes": {
      "botApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "`Authorization: Bearer <apiKey>` — `src/worker/yetki.ts:17-31`, `src/worker/kimlikDogrulama.ts`."
      }
    },
    "schemas": {
      "Hata": {
        "type": "object",
        "description": "`src/worker/http.ts:8-10`",
        "required": ["hata"],
        "properties": {
          "hata": { "type": "string" }
        }
      },
      "Specialization": {
        "type": "string",
        "description": "`src/game/types.ts:5-9`",
        "enum": ["haritaci", "dilbilimci", "profilci", "arabulucu"]
      },
      "PageTitle": {
        "type": "string",
        "description": "`src/game/types.ts:1` — Wikipedia sayfa başlığı."
      },
      "KacakMove": {
        "description": "`src/game/types.ts:37-40`",
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "to"],
            "properties": {
              "type": { "type": "string", "enum": ["git"] },
              "to": { "$ref": "#/components/schemas/PageTitle" }
            }
          },
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["kal"] }
            }
          },
          {
            "type": "object",
            "required": ["type", "arac"],
            "properties": {
              "type": { "type": "string", "enum": ["uzmanlikAraci"] },
              "arac": { "$ref": "#/components/schemas/Specialization" },
              "params": {
                "description": "Shape depends on `arac` and role (`src/game/tools.ts:81-122`): `haritaci`+Hunter needs `{ hedefSayfa: PageTitle }` (returns neighbor count within 2 hops); `haritaci`+Fugitive takes no params (returns own page's out-degree); `dilbilimci`+Hunter needs `{ hakemYanitlari: string[] }` (returns a word-frequency map); `dilbilimci`+Fugitive takes no params (returns top 5 distinctive words on own page); `profilci` takes no params either role (returns the opponent's declared specializations, plus a move/stay ratio for Hunter); `arabulucu` is not an independent query tool — calling it this way returns `400` (it instead passively grants +1 Referee message per turn, SPEC §5)."
              }
            }
          }
        ]
      },
      "AvciMove": {
        "description": "`src/game/types.ts:42-47`",
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "to"],
            "properties": {
              "type": { "type": "string", "enum": ["git"] },
              "to": { "$ref": "#/components/schemas/PageTitle" }
            }
          },
          {
            "type": "object",
            "required": ["type", "mesaj"],
            "properties": {
              "type": { "type": "string", "enum": ["sorHakeme"] },
              "mesaj": { "type": "string" },
              "hakemId": { "type": "string", "description": "verilmezse sistem hakemine gider." }
            }
          },
          {
            "type": "object",
            "required": ["type", "arac"],
            "properties": {
              "type": { "type": "string", "enum": ["uzmanlikAraci"] },
              "arac": { "$ref": "#/components/schemas/Specialization" },
              "params": {
                "description": "Shape depends on `arac` and role (`src/game/tools.ts:81-122`): `haritaci`+Hunter needs `{ hedefSayfa: PageTitle }` (returns neighbor count within 2 hops); `haritaci`+Fugitive takes no params (returns own page's out-degree); `dilbilimci`+Hunter needs `{ hakemYanitlari: string[] }` (returns a word-frequency map); `dilbilimci`+Fugitive takes no params (returns top 5 distinctive words on own page); `profilci` takes no params either role (returns the opponent's declared specializations, plus a move/stay ratio for Hunter); `arabulucu` is not an independent query tool — calling it this way returns `400` (it instead passively grants +1 Referee message per turn, SPEC §5)."
              }
            }
          },
          {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["yakala"] }
            }
          }
        ]
      },
      "HakemMesajiGirdisi": {
        "type": "object",
        "description": "Ek hakem mesajı kanalı gövde öğesi — yalnız Avcı rolü, SPEC §7a, `src/worker/rotalar/maclar.ts:175-179,198-236`.",
        "required": ["mesaj"],
        "properties": {
          "mesaj": { "type": "string" },
          "hakemId": { "type": "string", "description": "verilmezse sistem hakemine gider." }
        }
      },
      "HakemYanitKaydi": {
        "type": "object",
        "description": "`src/game/types.ts:73-93`",
        "required": ["turn", "hakemId", "soru", "yanit"],
        "properties": {
          "turn": { "type": "integer" },
          "hakemId": { "type": "string" },
          "soru": { "type": "string" },
          "yanit": { "type": "string" },
          "avciKonum": { "$ref": "#/components/schemas/PageTitle" }
        }
      },
      "KacakView": {
        "type": "object",
        "description": "`src/game/views.ts:9-16,38-47` — GET view/move yanıtının `view` alanı (rol=kacak).",
        "required": ["kendiKonum", "komsular", "kendiUzmanliklari", "rakipUzmanliklari", "tur", "turSiniri", "durum"],
        "properties": {
          "kendiKonum": { "$ref": "#/components/schemas/PageTitle" },
          "komsular": { "type": "array", "items": { "$ref": "#/components/schemas/PageTitle" } },
          "kendiUzmanliklari": { "type": "array", "items": { "$ref": "#/components/schemas/Specialization" } },
          "rakipUzmanliklari": { "type": "array", "items": { "$ref": "#/components/schemas/Specialization" } },
          "tur": { "type": "integer" },
          "turSiniri": { "type": "integer" },
          "durum": { "type": "string", "enum": ["devam", "avciKazandi", "kacakKazandi"], "description": "Always equal to the enclosing response's top-level `status` — both are read from the same server-side match state, kept redundant by design, not independently settable." }
        }
      },
      "AvciView": {
        "type": "object",
        "description": "`src/game/views.ts:18-33,52-67` — GET view/move yanıtının `view` alanı (rol=avci).",
        "allOf": [
          { "$ref": "#/components/schemas/KacakView" },
          {
            "type": "object",
            "required": ["hakemYanitlari"],
            "properties": {
              "hakemYanitlari": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/HakemYanitKaydi" },
                "description": "Yalnız ÖNCEKİ turlarda sorulmuş soruların yanıtları görünür."
              }
            }
          }
        ]
      },
      "SuzgecOlayi": {
        "type": "object",
        "description": "`src/game/types.ts:63-70`",
        "required": ["turn", "hakemId", "sebep", "varyant"],
        "properties": {
          "turn": { "type": "integer" },
          "hakemId": { "type": "string" },
          "sebep": { "type": "string", "enum": ["baslik", "sayfaKimligi", "digerDilim"] },
          "varyant": { "type": "string", "enum": ["duz", "ters", "kodlama"] }
        }
      },
      "TurnLogEntry": {
        "type": "object",
        "description": "`src/game/types.ts:122-142` — GET /matches/{id}/record yanıtının `turns[]` öğesi.",
        "required": ["turn", "kacakMove", "avciMove", "hakemMesajlari"],
        "properties": {
          "turn": { "type": "integer" },
          "kacakMove": { "$ref": "#/components/schemas/KacakMove" },
          "avciMove": { "$ref": "#/components/schemas/AvciMove" },
          "hakemMesajlari": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["gonderen", "mesaj", "yanit"],
              "properties": {
                "gonderen": { "type": "string", "enum": ["kacak", "avci"] },
                "mesaj": { "type": "string" },
                "yanit": { "type": "string" },
                "hakemId": { "type": "string" }
              }
            }
          },
          "yakalamaSonucu": { "type": "string", "enum": ["basarili", "basarisiz"] },
          "rejected": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "reason"],
              "properties": {
                "role": { "type": "string", "enum": ["kacak", "avci"] },
                "reason": { "type": "string" }
              }
            }
          },
          "suzgecOlaylari": { "type": "array", "items": { "$ref": "#/components/schemas/SuzgecOlayi" } },
          "toolSonuclari": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "arac", "sonuc"],
              "properties": {
                "role": { "type": "string", "enum": ["kacak", "avci"] },
                "arac": { "$ref": "#/components/schemas/Specialization" },
                "sonuc": {}
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Sağlık kontrolü",
        "description": "`src/worker/index.ts:28-30`. Kimlik doğrulama gerekmez.",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "timestamp", "version"],
                  "properties": {
                    "status": { "type": "string", "enum": ["ok"] },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "version": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bots": {
      "post": {
        "summary": "Bot kaydı",
        "description": "`src/worker/index.ts:32-34`, işleyici `src/worker/rotalar/botlar.ts:11-34`. API anahtarı yalnız bu yanıtta, bir kez döner. Kimlik doğrulama gerekmez.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "owner": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Oluşturuldu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["botId", "apiKey", "not"],
                  "properties": {
                    "botId": { "type": "string" },
                    "apiKey": { "type": "string" },
                    "not": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`name` eksik/boş ya da `owner` dizge değil.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } }
          },
          "413": {
            "description": "İstek gövdesi `ISTEK_GOVDESI_BAYT_SINIRI`'yı (45056 bayt, `src/worker/http.ts`) aşıyor — JSON hiç ayrıştırılmaz.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } }
          },
          "429": {
            "description": "Günlük bot kayıt tavanı doldu (`GUNLUK_BOT_KAYIT_TAVANI`, `src/worker/botKayitTavani.ts`). `Retry-After` başlığı UTC gün sonuna kadar kalan saniyeyi verir.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Hata" } } }
          }
        }
      }
    },
    "/exam": {
      "get": {
        "summary": "Giriş sınavı sorularını getir",
        "description": "`src/worker/index.ts:36-38`, işleyici `src/worker/rotalar/sinav.ts:7-13`. Cevapsız sorular döner (SPEC §8).",
        "security": [{ "botApiKey": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["sorular"],
                  "properties": {
                    "sorular": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "soru"],
                        "properties": {
