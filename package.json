{
  "name": "ak-1835-1903",
  "version": "0.1.0",
  "description": "AK-1835-1903 — Tactical training ground for AI agents",
  "main": "src/worker/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler build",
    "worldgen": "node tools/worldgen/generator.js",
    "worldgen:test": "node tools/worldgen/generator.js --test",
    "scc": "node tools/worldgen/scc.js",
    "seed": "node db/generate-seed.js",
    "worldgen:worker": "node tools/worldgen/minify-for-worker.js",
    "d1:local:migrate": "npx --no-install wrangler d1 execute ak-1835-1903 --local --file=db/schema-api.sql",
    "d1:local:migrations:apply": "npx --no-install wrangler d1 migrations apply ak-1835-1903 --local",
    "d1:local:migrations:list": "npx --no-install wrangler d1 migrations list ak-1835-1903 --local",
    "d1:local:migrations:create": "npx --no-install wrangler d1 migrations create ak-1835-1903",
    "d1:local:query": "npx --no-install wrangler d1 execute ak-1835-1903 --local --command",
    "types:worker": "npx --no-install wrangler types worker-configuration.d.ts",
    "typecheck:game": "npx --no-install typescript --noEmit -p tsconfig.game.json",
    "typecheck:worker": "npx --no-install typescript --noEmit -p tsconfig.worker.json",
    "test:game": "npx --no-install tsx test/leak.test.ts && npx --no-install tsx test/tools.test.ts && npx --no-install tsx test/simulate.ts && npx --no-install tsx test/hakem_dilim.test.ts && npx --no-install tsx test/hakem_sizinti.test.ts && npx --no-install tsx test/hakem_suzgec_stres.ts && npx --no-install tsx test/guvenilmeyen_metin.test.ts",
    "test:api": "npx --no-install tsx test/api/api.test.ts",
    "test:worker": "npx --no-install tsx test/worker/workersAiHakemi.test.ts && npx --no-install tsx test/worker/kindi.test.ts && npx --no-install tsx test/worker/hakemKopru.test.ts",
    "test:kota": "npx --no-install tsx test/worker/kalisiKota.test.ts",
    "test:hakemMesajlari": "npx --no-install tsx test/worker/hakemMesajlari.test.ts",
    "test:modelCagriSiniri": "npx --no-install tsx test/worker/modelCagriSiniri.test.ts",
    "test:hataYakalayici": "npx --no-install tsx test/worker/hataYakalayici.test.ts",
    "test:botKayitTavani": "npx --no-install tsx test/worker/botKayitTavani.test.ts",
    "test:istekSinirlari": "npx --no-install tsx test/worker/istekSinirlari.test.ts",
    "olcum:kindi": "npx --no-install tsx test/worker/kindi_denge.ts",
    "olcum:hakem": "npx --no-install tsx test/hakem_olcum.ts",
    "olcum:kategori": "npx --no-install tsx test/kategori_kural.ts",
    "olcum:suzgecCpu": "npx --no-install tsx test/hakem_suzgec_cpu.ts",
    "olcum:gercekModel": "npx --no-install tsx test/olcum/gercekModelOlcumu.ts",
    "typecheck:olcum": "npx --no-install typescript --noEmit -p tsconfig.olcum.json",
    "olcum:cakisma": "npx --no-install tsx test/olcum/cakismaDogrulamasi.ts"
  },
  "keywords": [
    "ai",
    "training",
    "game",
    "cloudflare-workers",
    "wikipedia"
  ],
  "author": "Luan Doçi, DeeOneXm",
  "license": "Apache-2.0",
  "devDependencies": {
    "wrangler": "^4.86.0",
    "typescript": "^5.0.0",
    "tsx": "^4.23.0",
    "@types/node": "^22.0.0"
  }
}
